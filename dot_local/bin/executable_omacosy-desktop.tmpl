#!/bin/sh

set -eu

{{- $policy := include ".chezmoitemplates/omacosy-package-policy.toml" | fromToml }}
checkout="$HOME/{{ trimPrefix "~/" $policy.checkout_path }}"
pinned_commit={{ $policy.tested_commit | quote }}
private_repository={{ $policy.private_repository | quote }}
omacosy="$checkout/bin/omacosy"

fail() {
  printf 'omacosy-desktop: %s\n' "$*" >&2
  exit 1
}

command -v git >/dev/null 2>&1 || fail "git is required to validate $checkout"
[ -d "$checkout" ] || fail "checkout not found at $checkout; prepare it from $private_repository"

inside_worktree=$(git -C "$checkout" rev-parse --is-inside-work-tree 2>/dev/null) ||
  fail "$checkout is not a Git worktree"
[ "$inside_worktree" = true ] || fail "$checkout is not a Git worktree"

worktree_root=$(git -C "$checkout" rev-parse --show-toplevel 2>/dev/null) ||
  fail "cannot resolve the Git worktree root for $checkout"
worktree_root=$(CDPATH= cd -- "$worktree_root" && pwd -P) ||
  fail "cannot resolve the Git worktree root for $checkout"
checkout_root=$(CDPATH= cd -- "$checkout" && pwd -P) ||
  fail "cannot resolve checkout path $checkout"
[ "$worktree_root" = "$checkout_root" ] ||
  fail "$checkout is not the root of its Git worktree (found $worktree_root)"

actual_commit=$(git -C "$checkout" rev-parse --verify HEAD 2>/dev/null) ||
  fail "cannot resolve HEAD in $checkout"
[ "$actual_commit" = "$pinned_commit" ] ||
  fail "HEAD mismatch in $checkout: expected $pinned_commit, found $actual_commit"

origin_urls=$(git -C "$checkout" remote get-url --all origin 2>/dev/null) ||
  fail "origin is missing in $checkout; expected $private_repository"
case "$origin_urls" in
  git@github-personal:KaviiSuri/omacosy.git | \
  git@github.com:KaviiSuri/omacosy.git | \
  ssh://git@github-personal/KaviiSuri/omacosy.git | \
  ssh://git@github.com/KaviiSuri/omacosy.git | \
  https://github.com/KaviiSuri/omacosy | \
  https://github.com/KaviiSuri/omacosy.git)
    ;;
  *)
    fail "origin refusal in $checkout: expected the private KaviiSuri/omacosy repository, found $origin_urls"
    ;;
esac

dirty_state=$(
  GIT_OPTIONAL_LOCKS=0 git -C "$checkout" status \
    --porcelain=v1 --untracked-files=all --ignored=matching 2>/dev/null
) ||
  fail "cannot inspect checkout cleanliness at $checkout"
[ -z "$dirty_state" ] ||
  fail "checkout is not clean at $checkout; commit or remove these entries:\n$dirty_state"

[ -x "$omacosy" ] || fail "expected executable is missing or not executable: $omacosy"

exec "$omacosy" "$@"
