{{- $email := promptStringOnce . "email" "Default git author email (the identity for this machine's everyday work)" -}}
{{- $name := promptStringOnce . "name" "Default git author name" -}}
{{- $personalSshKey := promptStringOnce . "personalSshKey" "Private key in ~/.ssh that authenticates as the personal GitHub account" "id_ed25519_personal" -}}
# -*-mode:conf-toml-*- vim:ft=toml

# ~/.config/chezmoi/chezmoi.toml
# =============================================================================
# Generated from .chezmoi.toml.tmpl by `chezmoi init`. Holds the values that
# differ per machine, which is why they live in config rather than in a managed
# dotfile. promptStringOnce only asks when a key is absent, so re-running init on
# an already-configured machine is silent.
#
# See https://www.chezmoi.io/user-guide/setup/

[data]
    # Default identity. On a personal-only machine set this to the personal
    # identity and everything inherits it. Where the day job is the default, the
    # includeIf rules in .gitconfig override it for personal directories.
    email = {{ $email | quote }}
    name = {{ $name | quote }}

    # Backs the IdentityFile of the `github-personal` SSH host. The same account
    # is reached through a differently named key on each machine.
    personalSshKey = {{ $personalSshKey | quote }}
